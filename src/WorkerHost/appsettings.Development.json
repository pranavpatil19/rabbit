{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "BrokerOptions": {
    "Connection": {
      "ConnectionString": "",
      "Host": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "ClientProvidedName": "WorkerHost.QueueWorker",
      "AutomaticRecoveryEnabled": true,
      "BindingsRecoveryEnabled": true
    },
    "WorkEndpoint": {
      "Exchange": {
        "Name": "work-commands",
        "Type": "direct",
        "Durable": true,
        "AutoDelete": false,
        "Arguments": { }
      },
      "Queue": {
        "Name": "work-requests",
        "Durable": true,
        "Exclusive": false,
        "AutoDelete": false,
        "Arguments": { }
      },
      "BindingArguments": {
      },
      "RoutingKey": "work-route",
      "DeclareInfrastructure": true,
      "DeadLetter": {
        "Enabled": true,
        "ExchangeName": "work-requests.dlx",
        "ExchangeType": "direct",
        "QueueName": "work-requests.dlx.queue",
        "RoutingKey": "work-requests.dlx",
        "MessageTtlMilliseconds": 600000,
        "ExchangeArguments": { },
        "QueueArguments": { },
        "BindingArguments": { }
      }
    },
    "DefaultBatchLimit": 10,
    "MaxBatchLimit": 200,
    "DefaultConcurrency": 5,
    "MaxConcurrency": 32,
    "MaxRequeueAttempts": null,
    "ScopeConcurrencyLimits": {
    },
    "PullTimeoutSeconds": 1.0,
    "RequeueOnError": true,
    "LogSequenceChannelName": "migration-log-channel",
    "ListenerInactivityThresholdSeconds": 120,
    "ListenerMetricsLogIntervalSeconds": 60
  },
  "TestDataOptions": {
    "DataFilePath": "testdata/sample_data.json"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Formatting.Compact", "Serilog.Enrichers.Thread" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "Properties": {
      "Application": "WorkerHost"
    }
  }
}
